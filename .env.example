# Comfy Clicker — environment
# Copy to .env.local. Everything here is optional: without Supabase the game runs in
# guest mode (local saves, deterministic trending, no leaderboard / ComfyHub).

# --- Supabase (public; inlined into the client bundle) ------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site URL -------------------------------------------------------------------
# Where confirmation emails send people back to. Set it to the deployed URL in Vercel;
# leave it empty locally so links point at the dev server. Must also be in the Supabase
# redirect allow-list (Auth > URL configuration).
NEXT_PUBLIC_SITE_URL=

# --- Supabase (server only — never expose) -------------------------------------
# Service-role key. Used by the feed pipeline, hub counters and refresh_hub_runs_24h().
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron ----------------------------------------------------------------------
# Shared secret for cron route handlers. Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`. Cron endpoints are closed when unset.
CRON_SECRET=
